DATABASE_URL=postgresql://ffhandball:ffhandball@localhost:5432/ffhandball
SCRAPE_USER_AGENT=ffhandball-data-bot/0.1 (contact: TODO@example.com)
# Plancher par domaine : 1 requête démarrée au plus par intervalle (politesse).
SCRAPE_RATE_LIMIT_MS=1500
# Plancher DÉDIÉ au domaine média FdM (media-ffhb-fdm.ffhandball.fr) : CloudFront → origine bride
# l'IP au 405 sur les cache-miss PDF. Le ralentir nettement évite de déclencher le bridage (et
# donc les cooldowns de 60–300 s) → bien plus rapide au final qu'un rythme agressif qui se fait
# brider en boucle. NE PAS le mettre aussi bas que SCRAPE_RATE_LIMIT_MS.
SCRAPE_FDM_RATE_LIMIT_MS=1500
# Poules traitées en parallèle (matchs/classements) pour masquer la latence d'insertion et
# soutenir un intervalle court. Débit ≈ min(concurrence/latence, 1000/rate-limit) req/s.
SCRAPE_CONCURRENCY=2
SCRAPE_RETRY_MAX=3
# Anti-bridage : sur HTTP 403/405/429 (CloudFront/origine bride l'IP sous le volume), on met le
# domaine en pause. Cooldown de base × nb de blocages consécutifs, plafonné.
SCRAPE_COOLDOWN_MS=60000
SCRAPE_COOLDOWN_MAX_MS=300000
# --journees=recent : fenêtre (jours) des journées récemment jouées re-scrapées aux runs réguliers.
SCRAPE_MATCHS_RECENT_DAYS=14
LOG_LEVEL=info
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
API_RATE_LIMIT_PER_MIN=60
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100

# --- Authentification par clé API (monétisation) ---
# true => endpoints data protégés par clé (Authorization: Bearer <token>). Défaut false (mode libre).
API_AUTH_ENABLED=false
# Secret protégeant les endpoints /admin/api-keys (≥16 chars). Laisser vide => admin désactivé (503).
# Génère-le avec : openssl rand -hex 32
ADMIN_SECRET=
# Rate-limit par défaut (req/min) attribué à une nouvelle clé API
API_KEY_DEFAULT_RATE_LIMIT_PER_MIN=120
