DATABASE_URL=postgresql://ffhandball:ffhandball@localhost:5432/ffhandball
SCRAPE_USER_AGENT=ffhandball-data-bot/0.1 (contact: TODO@example.com)
SCRAPE_RATE_LIMIT_MS=1500
SCRAPE_CONCURRENCY=2
SCRAPE_RETRY_MAX=3
LOG_LEVEL=info
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
API_RATE_LIMIT_PER_MIN=60
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100

# --- Authentification par clé API (monétisation) ---
# true => endpoints data protégés par clé (Authorization: Bearer <token>). Défaut false (mode libre).
API_AUTH_ENABLED=false
# Secret protégeant les endpoints /admin/api-keys (≥16 chars). Laisser vide => admin désactivé (503).
# Génère-le avec : openssl rand -hex 32
ADMIN_SECRET=
# Rate-limit par défaut (req/min) attribué à une nouvelle clé API
API_KEY_DEFAULT_RATE_LIMIT_PER_MIN=120
