# Site vitrine (fichiers statiques de site/). L'API est servie à part, sur son propre sous-domaine
# (cf. ffhandball-api.conf.template). Domaine canonique : {{SITE_DOMAIN}} ; www redirige vers lui.
# HTTPS : `certbot --nginx -d {{SITE_DOMAIN}} -d www.{{SITE_DOMAIN}}` une fois le DNS en place ;
# certbot ajoute alors les blocs 443 (le bloc www garde sa redirection vers le domaine canonique).
server {
    listen 80;
    listen [::]:80;
    server_name www.{{SITE_DOMAIN}};
    return 301 https://{{SITE_DOMAIN}}$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{SITE_DOMAIN}};

    # Sondes de scanners coupées sans réponse (.env, .git, PHP, WordPress…)
    include snippets/ffhandball-block-scanners.conf;

    root {{APP_DIR}}/site;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" always;

    access_log /var/log/nginx/ffhandball-site.access.log;
    error_log /var/log/nginx/ffhandball-site.error.log;
}
