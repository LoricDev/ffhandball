limit_req_zone $binary_remote_addr zone=ffhandball_api:10m rate=120r/m;

server {
    listen 80;
    server_name {{DOMAIN}};

    # Let's Encrypt verification (avant certbot HTTPS redirect)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        limit_req zone=ffhandball_api burst=20 nodelay;
    }

    # Logs séparés pour cette app
    access_log /var/log/nginx/ffhandball-api.access.log;
    error_log /var/log/nginx/ffhandball-api.error.log;
}
