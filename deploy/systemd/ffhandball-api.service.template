[Unit]
Description=ffhandball API HTTP
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{APP_DIR}}
ExecStart={{NODE_PATH}} --env-file={{APP_DIR}}/.env --import tsx {{APP_DIR}}/src/api/server.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening (ProtectSystem=full : /usr /boot /etc en lecture seule ; APP_DIR reste
# inscriptible pour le cache de compilation tsx. L'API n'écrit aucun fichier — logs → journald.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
