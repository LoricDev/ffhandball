# Production env file
# Generated by deploy/setup-app.sh on {{DATE}}
# IMPORTANT : chmod 600 sur ce fichier (fait automatiquement par setup-app.sh)

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ffhandball:{{POSTGRES_PASSWORD}}@localhost:5432/ffhandball

# ─── Scraping ─────────────────────────────────────────────────────────────────
# User-Agent identifiable avec adresse de contact réelle (obligatoire)
SCRAPE_USER_AGENT=ffhandball-data-bot/1.0 (contact: {{CONTACT_EMAIL}})
# Rate-limit généreux en prod (politesse vis-à-vis de ffhandball.fr)
SCRAPE_RATE_LIMIT_MS=2000
# 1 seul scraper concurrent en prod (politesse)
SCRAPE_CONCURRENCY=1
SCRAPE_RETRY_MAX=3

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
# Binding local uniquement — nginx fait le reverse proxy
API_HOST=127.0.0.1
API_RATE_LIMIT_PER_MIN=120
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
